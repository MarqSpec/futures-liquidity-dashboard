# Copy to .env (git-ignored) and fill in. Names only here - never a real value.
# Market-data feed: Synthetic (default, no credentials), Replay or ProjectX (TopstepX).
FEED_PROVIDER=
# ProjectX (TopstepX) gateway credentials, only for FEED_PROVIDER=ProjectX. Prefer user-secrets for local runs.
# Placeholders only - never a real value. Set exactly one pair.
# Preferred (loginKey userName + apiKey). If this pair is set, it wins and PROJECTX_API_SECRET is ignored.
PROJECTX_USERNAME=
PROJECTX_API_KEY=
# Older pair: PROJECTX_API_KEY is the user name and PROJECTX_API_SECRET is the api key.
# Leave PROJECTX_API_SECRET empty when using the preferred pair.
PROJECTX_API_SECRET=
# Host address compose publishes the API on. The default is 127.0.0.1, which a phone cannot reach.
# Set 0.0.0.0 only while a phone on the LAN needs the API. That exposes Development's anonymous
# grants, and any viewer key sent over HTTP, to every device on the network. Unset it when you are done.
# API_BIND_ADDRESS=127.0.0.1
# Viewer API key: store only the SHA-256 on the API. The dashboard asks for the raw key.
# Do not put the raw key in a VITE_* variable. See DEPLOYMENT.md section 3.
# Auth__Keys__0__KeySha256=
