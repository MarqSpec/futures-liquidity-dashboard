# Serves the built single-page app and reverse-proxies the API, its health checks and the SignalR hub.
# src/dashboard/10-api-upstream.sh runs `envsubst '${API_UPSTREAM}'` at container start and writes
# /etc/nginx/conf.d/default.conf. Only that name is substituted, so nginx's $host, $uri and
# $http_upgrade stay as nginx variables.
#
# API_UPSTREAM is an origin with no path (scheme, host, port). The Dockerfile defaults it to the compose
# service. On Railway set it to the API service's private hostname, for example
# http://futures-liquidity-dashboard.railway.internal:8080. The browser still talks to the dashboard
# origin, so the API sends no CORS headers.
#
# `Connection: upgrade` only when the client asked for a WebSocket; plain hub requests (negotiate) stay keep-alive.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# The hub key is the access_token query value. Log the path only, never $request, so that value is not written.
log_format redacted_request '$remote_addr - [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
    listen 8080;
    root /usr/share/nginx/html;
    access_log /dev/stdout redacted_request;

    # A prefix of /api/ does not match /api or /api?x=1: nginx matches the path, and that path is /api.
    # The exact location catches the bare path. The prefix catches everything under it, and not /apiary.
    location = /api {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
    }

    location /health/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
    }

    location = /metrics {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
    }

    location /metrics/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
    }

    # SignalR: /hubs/market/negotiate over HTTP, then /hubs/market as a WebSocket.
    # location /hubs/ is the prefix the image test requires. = /hubs covers /hubs and /hubs?x.
    location = /hubs {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /hubs/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        # The hub socket is long-lived; do not cut it during quiet periods.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # The shell must revalidate. A cached worker or manifest would keep a stale app after a deploy.
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
