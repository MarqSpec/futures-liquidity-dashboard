<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds deny cleartext for every domain. Debug builds replace this file
     with src/lan-cleartext/res/xml/network_security_config.xml, which permits cleartext
     only for loopback and the emulator host 10.0.2.2. DEPLOYMENT.md. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
