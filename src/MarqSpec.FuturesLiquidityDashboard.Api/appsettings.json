{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Feed": {
    "Provider": "ProjectX",
    "MinHistoryHours": 4,
    "ProjectX": {
      "ContractIds": {},
      "SearchLive": false,
      "SnapshotSettleMs": 1500,
      "LevelsPerSide": 50,
      "MaxContracts": 0,
      "HistoryMinIntervalMs": 650,
      "Quotes": true
    },
    "Depth": {
      "Mode": "Watched",
      "Pinned": [ "MES", "MCL", "MGC" ],
      "MaxSubscriptions": 8,
      "ReleaseDelayMs": 30000
    }
  },
  "Engine": {
    "Instruments": [ "*" ],
    "ExcludeInstruments": [],
    "Regime": {
      "TimeframesSeconds": [ 300, 900 ],
      "AdxPeriod": 14,
      "EfficiencyPeriod": 20,
      "EmaFast": 13,
      "EmaSlow": 48,
      "TrendAdx": 25,
      "TrendEfficiency": 0.3,
      "RangeAdx": 20,
      "RangeEfficiency": 0.2
    },
    "Tape": {
      "BaselineMinutes": 30,
      "ThinRatio": 0.25
    }
  },
  "Api": {
    "PublishMs": 250,
    "MaxWatchlist": 12
  },
  "Auth": {
    "Keys": [],
    "AnonymousGrants": []
  },
  "Agent": {
    "Enabled": true,
    "IntervalSeconds": 60
  },
  "Feedback": {
    "Enabled": false,
    "Provider": "Claude",
    "Model": "claude-opus-5-5",
    "Effort": "medium",
    "MonthlyBudgetUsd": 100
  }
}
