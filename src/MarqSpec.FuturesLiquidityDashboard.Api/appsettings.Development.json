{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Feed": {
    "Provider": "Synthetic",
    "MinHistoryHours": 4
  },
  "Auth": {
    "AnonymousGrants": [ "view-dashboard:*", "configure-layout:*", "read-context:*", "publish-overlay:*", "request-feedback:*" ]
  },
  "Feedback": {
    "Enabled": true,
    "Provider": "Mock"
  }
}
