<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>marqspec-futures-liquidity-dashboard-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The feedback budget and saved layouts are runtime data: never published, never in the image. -->
    <Content Remove="data/**" />
    <None Remove="data/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarqSpec.FuturesLiquidityDashboard.Ingestion\MarqSpec.FuturesLiquidityDashboard.Ingestion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MarqSpec.FuturesLiquidityDashboard.IntegrationTests" />
    <InternalsVisibleTo Include="MarqSpec.FuturesLiquidityDashboard.UnitTests" />
  </ItemGroup>

</Project>
